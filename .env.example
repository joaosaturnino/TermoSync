NODE_ENV=development
PORT=3001

# Banco de dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=termosync

# Segurança
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_HOURS=12
CORS_ORIGIN=http://172.16.0.71:5173
API_RATE_LIMIT_MAX=3000
IOT_INGEST_RATE_LIMIT_MAX=5000
LOGIN_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5
ROOT_PASSCODE_RATE_LIMIT_MAX=8
SLOW_REQUEST_MS=1200
IOT_INGEST_TOKEN=troque-por-um-token-longo-para-sensores
MQTT_USERNAME=termosync_iot
MQTT_PASSWORD=troque-por-uma-senha-mqtt-longa

# Upload/deploy pelo painel DEV
UPLOAD_TMP_DIR=tmp/
UPDATE_PACKAGE_MAX_MB=75
CHAMADO_ANEXO_MAX_MB=10
ALLOW_RAW_SQL_MUTATION=false
ALLOW_DESTRUCTIVE_SQL=false

# Backup automático local
# Ative em produção quando houver rotina de cópia externa ou disco confiável.
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_RETENTION=14
AUTO_BACKUP_RUN_ON_START=false
BACKUP_DIR=backend/backups

# SMTP para onboarding e testes de e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TEST_TO=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# SMS para recuperação de senha
# Opção principal: Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Alternativa ao TWILIO_FROM_NUMBER, se usar Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=

# Opção alternativa: webhook próprio de SMS
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Opção gratuita/limitada para testes com Textbelt
# TEXTBELT_ENABLED=true usa a chave pública "textbelt" com limite baixo.
TEXTBELT_ENABLED=true
TEXTBELT_API_KEY=
TEXTBELT_SENDER=ThermoSync
TEXTBELT_URL=https://textbelt.com/text

# SMS barato via Android + chip próprio usando textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_SUBSCRIPTION_ID=
TEXTBEE_URL=https://api.textbee.dev/api/v1/gateway/send-sms
WHATSAPP_ENABLED=false
