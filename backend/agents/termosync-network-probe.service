[Unit]
Description=TermoSync Raspberry Network Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=termosync
WorkingDirectory=/opt/termosync/backend
EnvironmentFile=/etc/termosync/network-probe.env
ExecStart=/usr/bin/node /opt/termosync/backend/agents/networkProbeAgent.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
